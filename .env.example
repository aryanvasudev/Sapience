# Copy to .env.local and fill in. Never put a secret behind NEXT_PUBLIC_.
# Validated at boot by src/env.ts — the server refuses to start with a bad config.

# ---------------------------------------------------------------------------
# Browser-safe
# ---------------------------------------------------------------------------
# Local stack: `pnpm exec supabase status` prints the API URL and the publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=          # optional; Turnstile on sign-in, sign-up and guest sign-in. Set it together
                                         # with Supabase Auth captcha protection (Turnstile secret key goes there)

# ---------------------------------------------------------------------------
# Server-only
# ---------------------------------------------------------------------------
SUPABASE_SECRET_KEY=                     # required: lesson cache, grading, jobs (local: `supabase status`)
YOUTUBE_API_KEY=                         # required; free (10,000 units/day). Restrict to YouTube Data API v3.

# AI providers (Section 4.5) — default is setup A: one free AI Studio key, no billing
AI_TEXT_PROVIDER=gemini                  # gemini | openrouter
AI_VIDEO_PROVIDER=gemini                 # gemini | openrouter | none
GOOGLE_GENERATIVE_AI_API_KEY=            # free key from Google AI Studio (required if either provider is gemini)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=                      # optional (required if either provider is openrouter)
OPENROUTER_MODEL=                        # e.g. a Gemini Flash model ID, or a ":free" model for text
OPENROUTER_LITE_MODEL=
OPENROUTER_VIDEO_MODEL=                  # must route to Gemini on Google AI Studio for YouTube links
AI_MAX_CONCURRENT_JOBS=2
BYOK_ENCRYPTION_KEY=                     # optional; enables "Use your own AI key" in Settings. 32 random bytes,
                                         # base64 (openssl rand -base64 32). Don't change it later: stored keys become unreadable.
PROMPT_VERSION=v3
INTERNAL_JOB_SECRET=                     # required; 32+ random characters (openssl rand -hex 32)
APP_INTERNAL_URL=                        # optional override for job dispatch
VERCEL_AUTOMATION_BYPASS_SECRET=         # set automatically on Vercel when Protection Bypass for Automation is enabled
ADMIN_EMAILS=                            # optional, comma-separated; these accounts see /app/admin/usage

# Lesson generation
LESSON_BUILD_MODE=captions               # captions (YouTube captions + text model; no captions → student's own key) | video
TRANSCRIPT_API_KEY=                      # optional; transcriptapi.com key (1 credit per transcript). Tried first when YouTube refuses the server's caption lookup
YOUTUBE_TRANSCRIPT_AI_KEY=               # optional; youtube-transcript.ai key (free: 10/day). Used when YouTube refuses the server's caption lookup (it refuses Vercel)
LESSON_MAX_VIDEO_MINUTES=90
LESSON_SINGLE_PASS_MAX_MINUTES=15
LESSON_BATCH_MAX_MINUTES=15
LESSON_OUTLINE_FPS=0.25
LESSON_DETAIL_FPS=0.5

# Tutor
TUTOR_CLIP_MODE=on_demand                # on_demand (free-tier default) | always
TUTOR_CLIP_BEFORE_SECONDS=90
TUTOR_CLIP_AFTER_SECONDS=20
TUTOR_CLIP_RESOLUTION=MEDIA_RESOLUTION_MEDIUM
TUTOR_CLIP_TIMEOUT_MS=15000

# Limits
LESSONS_DAILY_LIMIT_PER_USER=2           # free-tier defaults (Section 4.5.3); raise if billing is ever enabled
LESSONS_DAILY_LIMIT_GUEST=1
AI_DAILY_LIMIT_PER_USER=60
AI_DAILY_LIMIT_GUEST=20
GLOBAL_LESSONS_DAILY_LIMIT=4

# ---------------------------------------------------------------------------
# Local Supabase only (read by supabase/config.toml, not by the app)
# ---------------------------------------------------------------------------
# Google OAuth client for local sign-in. Export these in your shell before `pnpm db:start`.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
